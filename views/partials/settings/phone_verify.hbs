<form class="drawer-form" method="post" action="{{action}}" data-ajax-form novalidate>
  <header class="drawer-header">
    <div>
      <p class="eyebrow">Phone number</p>
      <h2 class="drawer-title" id="drawer-title">Verify {{phone}}</h2>
      <p class="drawer-subtitle">We texted a 6-digit code to this number. Enter it to confirm the phone is yours.</p>
    </div>
    <button type="button" class="icon-btn icon-btn-ghost" data-drawer-close aria-label="Close">{{icon "x" size=18}}</button>
  </header>
  <div class="drawer-content">
    {{#if notice}}<div class="alert alert-info">{{icon "info" size=16}}<span>{{notice}} Use the code we already sent.</span></div>{{/if}}
    {{> auth/field name="code" label="Code from the text message" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" error=errors.code autofocus=true}}
    <p class="field-hint">Wrong number? Change it under Profile above, then verify again. Didn't get it? <button type="button" class="link-button" data-post-url="{{resend}}">Send a new code</button></p>
  </div>
  <footer class="drawer-footer">
    <button type="button" class="btn btn-outline" data-drawer-close>Cancel</button>
    <button type="submit" class="btn btn-primary" data-loading-text="Checking…">Verify phone</button>
  </footer>
</form>

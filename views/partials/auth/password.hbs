<div class="field{{#if error}} has-error{{/if}}" data-password-field>
  <div class="field-label-row">
    <label class="field-label" for="{{name}}">{{label}}</label>
    {{#if forgot}}<a class="link link-sm" href="/auth/forgot-password">Forgot password?</a>{{/if}}
  </div>
  <div class="field-control">
    {{icon "lock-keyhole" size=16 class="field-icon"}}
    <input id="{{name}}" name="{{name}}" type="password" required
      autocomplete="{{#if autocomplete}}{{autocomplete}}{{else}}current-password{{/if}}"
      {{#if placeholder}}placeholder="{{placeholder}}"{{/if}}
      {{#if strength}}data-strength-input{{/if}}
      {{#if error}}aria-invalid="true" aria-describedby="{{name}}-error"{{/if}} />
    <button type="button" class="field-action" data-toggle-password aria-label="Show password" aria-pressed="false">
      <span data-icon-show>{{icon "eye" size=16}}</span>
      <span data-icon-hide hidden>{{icon "eye-off" size=16}}</span>
    </button>
  </div>
  <p class="field-caps" data-caps-warning hidden>{{icon "arrow-big-up" size=13}} Caps Lock is on</p>
  {{#if strength}}
    <div class="strength" data-strength aria-live="polite">
      <div class="strength-bars"><span></span><span></span><span></span><span></span></div>
      <span class="strength-label" data-strength-label>{{#unless error}}{{hint}}{{/unless}}</span>
    </div>
  {{/if}}
  {{#if error}}
    <p class="field-error" id="{{name}}-error">{{error}}</p>
  {{/if}}
</div>

<div class="field{{#if error}} has-error{{/if}}">
  <label class="field-label" for="code-1">Verification code</label>
  <div class="otp" data-otp>
    <input id="code-1" name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1" required autofocus {{#if error}}aria-invalid="true"{{/if}} />
    <input name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 2" required {{#if error}}aria-invalid="true"{{/if}} />
    <input name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 3" required {{#if error}}aria-invalid="true"{{/if}} />
    <span class="otp-sep" aria-hidden="true"></span>
    <input name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 4" required {{#if error}}aria-invalid="true"{{/if}} />
    <input name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 5" required {{#if error}}aria-invalid="true"{{/if}} />
    <input name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 6" required {{#if error}}aria-invalid="true"{{/if}} />
  </div>
  {{#if error}}<p class="field-error">{{error}}</p>{{/if}}
</div>

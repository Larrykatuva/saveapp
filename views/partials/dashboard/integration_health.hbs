{{!-- API keys, webhook endpoints and the last event of a business. Takes health (OverviewPresenter) and integrationsUrl. --}}
<section class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Integration health</h2>
      <p class="card-subtitle">{{#if health.ready}}{{#if owner}}{{owner}}{{else}}Your{{/if}} systems are connected to SaveApp.{{else}}{{#if owner}}The merchant needs{{else}}Add{{/if}} an API key and a webhook endpoint to go live.{{/if}}</p>
    </div>
    <a class="btn btn-outline btn-sm" href="{{#if integrationsUrl}}{{integrationsUrl}}{{else}}/merchant/integrations{{/if}}">Open</a>
  </div>
  <div class="card-body">
    <dl class="detail-rows">
      <div><dt>API keys</dt><dd><span class="entity-stack"><span>{{health.keys}}</span><span class="entity-sub">{{health.keysUsed}}</span></span></dd></div>
      <div><dt>Webhook endpoints</dt><dd>{{health.webhooks}}</dd></div>
      <div><dt>Last event</dt><dd>{{#if health.lastEvent}}<span class="entity-stack"><span><span class="code-chip">{{health.lastEvent.event}}</span> {{#if health.lastEvent.delivered}}{{> shared/status tone="success" label="Delivered" small=true}}{{else}}{{> shared/status tone="danger" label="Failed" small=true}}{{/if}}</span><span class="entity-sub">{{health.lastEvent.when}}</span></span>{{else}}<span class="muted">None yet</span>{{/if}}</dd></div>
      <div><dt>Last 30 days</dt><dd>{{health.deliveryRate}}</dd></div>
    </dl>
  </div>
</section>

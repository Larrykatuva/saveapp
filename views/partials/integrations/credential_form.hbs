<form class="drawer-form" method="post" action="{{action}}" data-ajax-form data-refresh="#credentials-table" novalidate>
  <header class="drawer-header">
    <div>
      <p class="eyebrow">API credential</p>
      <h2 class="drawer-title" id="drawer-title">{{#if editing}}{{credential.name}}{{else}}New credential{{/if}}</h2>
      <p class="drawer-subtitle">{{#if editing}}Client id <span class="code-chip">{{credential.hint}}…</span> · Created {{credential.created}}{{else}}We show the client id and secret once, right after you create it.{{/if}}</p>
    </div>
    <button type="button" class="icon-btn icon-btn-ghost" data-drawer-close aria-label="Close">{{icon "x" size=18}}</button>
  </header>

  <div class="drawer-content">
    {{#if hasErrors}}<div class="alert alert-error">{{icon "circle-alert" size=16}}<span>Please fix the highlighted fields.</span></div>{{/if}}

    {{#if editing}}
      <dl class="detail-rows">
        <div><dt>Status</dt><dd>{{#if credential.active}}{{> shared/status tone="success" label="Active"}}{{else}}{{> shared/status tone="neutral" label="Inactive"}}{{/if}}</dd></div>
        <div><dt>Last used</dt><dd>{{#if credential.lastUsed}}{{credential.lastUsed}}{{else}}<span class="muted">Never</span>{{/if}}</dd></div>
      </dl>
    {{/if}}

    {{> auth/field name="name" label="Name" value=values.name error=errors.name placeholder="e.g. Production server" autofocus=true disabled=(and editing (not canManage))}}

    <div class="field{{#if errors.scopes}} has-error{{/if}}">
      <span class="field-label">What this key can do</span>
      <div class="role-picks">
        {{#each scopes}}
          <label class="pick-row{{#unless available}} is-locked{{/unless}}">
            <input type="checkbox" name="scopes" value="{{value}}" {{#if checked}}checked{{/if}} {{#unless available}}disabled{{/unless}} {{#if (and ../editing (not ../canManage))}}disabled{{/if}} />
            <span class="pick-box">{{icon "check" size=12}}</span>
            <span class="pick-name">{{label}}</span>
            {{#unless available}}<span class="badge">Coming later</span>{{/unless}}
          </label>
        {{/each}}
      </div>
      {{#if errors.scopes}}<p class="field-error">{{errors.scopes}}</p>{{/if}}
    </div>

    <div class="field{{#if errors.ips}} has-error{{/if}}">
      <label class="field-label" for="ips">IP whitelist</label>
      <textarea id="ips" name="ips" class="textarea code-input" rows="4" placeholder="203.0.113.10&#10;198.51.100.24" {{#if (and editing (not canManage))}}disabled{{/if}}>{{values.ips}}</textarea>
      {{#if errors.ips}}<p class="field-error">{{errors.ips}}</p>{{else}}<p class="field-hint">One IP address per line. Only these addresses can get tokens and call the API. Required in production.</p>{{/if}}
    </div>

    {{#if editing}}
      {{#if canManage}}
        <div class="danger-zone">
          <div>
            <p class="field-label">Rotate secret</p>
            <p class="field-hint">Issue a new client secret. The current one stops working at once.</p>
          </div>
          <button type="button" class="btn btn-danger-outline btn-sm" data-confirm-url="/merchant/integrations/credentials/{{credential.id}}/rotate" data-confirm-title="Rotate the secret for {{credential.name}}?" data-confirm-text="Systems using the current secret will fail to get new tokens until you update them." data-confirm-label="Rotate secret" data-refresh="#credentials-table">{{icon "rotate-ccw" size=14}} Rotate</button>
        </div>
      {{/if}}

      <div class="field">
        <span class="field-label">Activity</span>
        {{#if logs.length}}
          <ul class="activity">
            {{#each logs}}
              <li>
                <span class="avatar avatar-sm">{{initials}}</span>
                <span class="entity-stack"><span class="entity-name">{{action}} <span class="entity-sub">· {{by}} · {{when}}</span></span><span class="entity-sub">{{description}}</span></span>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="field-hint">Nothing yet.</p>
        {{/if}}
      </div>
    {{/if}}
  </div>

  <footer class="drawer-footer">
    <button type="button" class="btn btn-outline" data-drawer-close>{{#if (and editing (not canManage))}}Close{{else}}Cancel{{/if}}</button>
    {{#unless (and editing (not canManage))}}
      <button type="submit" class="btn btn-primary" data-loading-text="Saving…">{{#if editing}}Save changes{{else}}Create credential{{/if}}</button>
    {{/unless}}
  </footer>
</form>

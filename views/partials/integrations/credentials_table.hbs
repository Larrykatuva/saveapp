{{#if credentials.length}}
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Credential</th>
          <th>Scopes</th>
          <th class="hide-md">IP whitelist</th>
          <th class="hide-md">Last used</th>
          <th>Active</th>
          <th class="col-actions"><span class="sr-only">Open</span></th>
        </tr>
      </thead>
      <tbody>
        {{#each credentials}}
          <tr class="row-link" data-drawer-url="/merchant/integrations/credentials/{{id}}">
            <td>
              <span class="entity">
                <span class="tile">{{icon "key-round" size=16}}</span>
                <span class="entity-stack"><span class="entity-name">{{name}}</span><span class="entity-sub"><span class="code-chip">{{hint}}…</span> · Created {{created}}</span></span>
              </span>
            </td>
            <td><span class="chip-list">{{#each scopes}}<span class="badge">{{this}}</span>{{/each}}</span></td>
            <td class="hide-md">{{#if ipCount}}<span title="{{#each ips}}{{this}} {{/each}}">{{ipCount}} address{{#unless (eq ipCount 1)}}es{{/unless}}</span>{{else}}<span class="muted">Any address</span>{{/if}}</td>
            <td class="hide-md">{{#if lastUsed}}{{lastUsed}}{{else}}<span class="muted">Never</span>{{/if}}</td>
            <td>
              {{#if @root.canManage}}
                <label class="switch" title="{{#if active}}Deactivate{{else}}Activate{{/if}} {{name}}">
                  <input type="checkbox" data-toggle-url="/merchant/integrations/credentials/{{id}}/toggle" {{#if active}}checked{{/if}} aria-label="{{name}} active" />
                  <span class="switch-track"><span class="switch-thumb"></span></span>
                </label>
              {{else}}
                {{#if active}}{{> shared/status tone="success" label="Active" small=true}}{{else}}{{> shared/status tone="neutral" label="Inactive" small=true}}{{/if}}
              {{/if}}
            </td>
            <td class="col-actions"><button type="button" class="icon-btn icon-btn-ghost icon-btn-xs" data-drawer-url="/merchant/integrations/credentials/{{id}}" aria-label="Open {{name}}">{{icon "chevron-right" size=16}}</button></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="empty-state">
    <span class="empty-icon">{{icon "key-round" size=20}}</span>
    <p class="empty-title">No credentials yet</p>
    <p class="empty-text">Create a credential to connect your systems to SaveApp and start issuing cards.</p>
    {{#if canManage}}<button type="button" class="btn btn-primary btn-sm" data-drawer-url="/merchant/integrations/credentials/new">{{icon "plus" size=14}} New credential</button>{{/if}}
  </div>
{{/if}}

<div class="drawer-form">
  <header class="drawer-header">
    <div>
      <p class="eyebrow">API credential</p>
      <h2 class="drawer-title" id="drawer-title">{{#if shown}}Copy your {{#if shown.clientId}}credentials{{else}}new secret{{/if}} now{{else}}Already shown{{/if}}</h2>
      <p class="drawer-subtitle">{{#if shown}}This is the only time we show {{#if shown.clientId}}them{{else}}it{{/if}}. Store {{#if shown.clientId}}them{{else}}it{{/if}} in your secrets manager.{{else}}For security we only show credentials once. Rotate the secret if you lost it.{{/if}}</p>
    </div>
    <button type="button" class="icon-btn icon-btn-ghost" data-drawer-close aria-label="Close">{{icon "x" size=18}}</button>
  </header>
  <div class="drawer-content">
    {{#if shown}}
      <div class="alert alert-warning">{{icon "triangle-alert" size=16}}<span>Once you close this panel the {{#if shown.clientId}}secret{{else}}new secret{{/if}} can't be shown again.</span></div>
      {{#if shown.clientId}}
        <div class="field">
          <span class="field-label">Client id</span>
          <div class="copy-field"><code>{{shown.clientId}}</code><button type="button" class="btn btn-outline btn-sm" data-copy="{{shown.clientId}}">{{icon "copy" size=14}} Copy</button></div>
        </div>
      {{/if}}
      <div class="field">
        <span class="field-label">Client secret</span>
        <div class="copy-field"><code>{{shown.clientSecret}}</code><button type="button" class="btn btn-outline btn-sm" data-copy="{{shown.clientSecret}}">{{icon "copy" size=14}} Copy</button></div>
      </div>
    {{/if}}
  </div>
  <footer class="drawer-footer">
    <button type="button" class="btn btn-primary" data-drawer-close>{{#if shown}}I've saved {{#if shown.clientId}}them{{else}}it{{/if}}{{else}}Close{{/if}}</button>
  </footer>
</div>

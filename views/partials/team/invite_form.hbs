<form class="drawer-form" method="post" action="{{action}}" data-ajax-form novalidate>
  <header class="drawer-header">
    <div>
      <h2 class="drawer-title" id="drawer-title">Invite people</h2>
      <p class="drawer-subtitle">We email them a link to join{{#if isStaff}} the SaveApp team{{else}} {{account.name}}{{/if}}. New people create their login from the link.</p>
    </div>
    <button type="button" class="icon-btn icon-btn-ghost" data-drawer-close aria-label="Close">{{icon "x" size=18}}</button>
  </header>

  <div class="drawer-content">
    {{> auth/field name="email" label="Email" type="email" icon="mail" value=values.email error=errors.email placeholder="name@business.co.ke" autofocus=true}}
    {{> auth/field name="fullName" label="Full name" icon="user-round" value=values.fullName error=errors.fullName placeholder="Prefills their sign up" optional=true}}

    <div class="field{{#if errors.roleId}} has-error{{/if}}">
      <span class="field-label">Role</span>
      <div class="radio-list">
        {{#each roles}}
          <label class="radio-card">
            <input type="radio" name="roleId" value="{{id}}" {{#if selected}}checked{{/if}} />
            <span>
              <span class="pick-name">{{name}}{{#if system}} <span class="badge">System</span>{{/if}}</span>
              {{#if description}}<span class="pick-desc">{{description}}</span>{{/if}}
            </span>
          </label>
        {{/each}}
      </div>
      {{#if errors.roleId}}<p class="field-error">{{errors.roleId}}</p>{{/if}}
    </div>
  </div>

  <footer class="drawer-footer">
    <button type="button" class="btn btn-outline" data-drawer-close>Cancel</button>
    <button type="submit" class="btn btn-primary" data-loading-text="Sending…">{{icon "send" size=15}} Send invitation</button>
  </footer>
</form>

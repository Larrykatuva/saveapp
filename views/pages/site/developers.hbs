    <section id="signatures" class="docs-section">
      <h2>Verify signatures</h2>
      <p>Every event carries these headers:</p>
      <table class="docs-table">
        <tbody>
          <tr><td><code>X-SaveApp-Event</code></td><td>The event name</td></tr>
          <tr><td><code>X-SaveApp-Delivery</code></td><td>The event id</td></tr>
          <tr><td><code>X-SaveApp-Timestamp</code></td><td>Unix seconds when it was sent</td></tr>
          <tr><td><code>X-SaveApp-Signature</code></td><td><code>sha256=</code> + HMAC-SHA256 of <code>&lt;timestamp&gt;.&lt;raw body&gt;</code> with the endpoint's signing secret</td></tr>
        </tbody>
      </table>
      <p>Compute the signature over the <strong>raw</strong> request body, compare in constant time, and reject events older than five minutes.</p>
      <div class="code-tabs" data-code-tabs>
        <div class="code-tabs-bar" role="tablist">
          <button type="button" class="is-active" data-code-tab="node">Node.js</button>
          <button type="button" data-code-tab="python">Python</button>
          <button type="button" data-code-tab="php">PHP</button>
        </div>
<pre data-code-panel="node">import crypto from 'node:crypto';
import express from 'express';

const app = express();

app.post('/webhooks/saveapp', express.raw({ type: 'application/json' }), (req, res) => {
  const timestamp = req.get('X-SaveApp-Timestamp');
  const expected = 'sha256=' + crypto
    .createHmac('sha256', process.env.SAVEAPP_WEBHOOK_SECRET)
    .update(`${timestamp}.${req.body}`)
    .digest('hex');
  const received = req.get('X-SaveApp-Signature') ?? '';
  const fresh = Math.abs(Date.now() / 1000 - Number(timestamp)) &lt; 300;
  const valid = received.length === expected.length &&
    crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));
  if (!valid || !fresh) return res.status(400).end();

  const event = JSON.parse(req.body);
  res.status(200).end(); // reply first, then handle the event
});</pre>
<pre data-code-panel="python" hidden>import hashlib, hmac, os, time
from flask import Flask, request, abort

app = Flask(__name__)

@app.post("/webhooks/saveapp")
def saveapp_webhook():
    timestamp = request.headers.get("X-SaveApp-Timestamp", "")
    body = request.get_data()  # raw bytes
    expected = "sha256=" + hmac.new(
        os.environ["SAVEAPP_WEBHOOK_SECRET"].encode(),
        f"{timestamp}.".encode() + body,
        hashlib.sha256,
    ).hexdigest()
    received = request.headers.get("X-SaveApp-Signature", "")
    if not hmac.compare_digest(received, expected) or abs(time.time() - int(timestamp)) > 300:
        abort(400)
    event = request.get_json()
    return "", 200</pre>
<pre data-code-panel="php" hidden>&lt;?php
$body = file_get_contents('php://input');
$timestamp = $_SERVER['HTTP_X_SAVEAPP_TIMESTAMP'] ?? '';
$expected = 'sha256=' . hash_hmac('sha256', $timestamp . '.' . $body, getenv('SAVEAPP_WEBHOOK_SECRET'));
$received = $_SERVER['HTTP_X_SAVEAPP_SIGNATURE'] ?? '';

if (!hash_equals($expected, $received) || abs(time() - (int) $timestamp) > 300) {
    http_response_code(400);
    exit;
}
$event = json_decode($body, true);
http_response_code(200);</pre>

<div class="auth-card">
  <header class="auth-header">
    <span class="auth-badge">{{icon "key-round" size=22}}</span>
    <h1 class="auth-title">Forgot your password?</h1>
    <p class="auth-subtitle">Enter the email you signed up with and we'll send you a code to reset it.</p>
  </header>

  {{> auth/alert}}

  <form method="post" action="/auth/forgot-password" class="auth-form" novalidate data-loading-form>
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    {{> auth/field name="email" label="Email" type="email" icon="mail" value=values.email error=errors.email autocomplete="email" placeholder="you@example.com" autofocus=true}}
    <button type="submit" class="btn btn-primary btn-block btn-lg" data-loading-text="Sending code…">Send reset code</button>
  </form>

  <p class="auth-switch"><a class="link link-muted" href="/auth/login">{{icon "arrow-left" size=14}} Back to sign in</a></p>
</div>

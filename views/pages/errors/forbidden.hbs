<main class="error-page">
  <div class="error-card">
    {{#if notFound}}
      <span class="confirm-icon">{{icon "search-x" size=22}}</span>
      <h1 class="auth-title">We couldn't find that</h1>
      <p class="auth-subtitle">It may have been removed, or the link is wrong.</p>
    {{else}}
      <span class="confirm-icon">{{icon "shield-alert" size=22}}</span>
      <h1 class="auth-title">You don't have access to this page</h1>
      <p class="auth-subtitle">Your role doesn't include the permission this page needs. Ask an admin to update your role if you think you should have access.</p>
    {{/if}}
    <div class="error-actions">
      <a class="btn btn-primary" href="{{homePath}}">{{icon "arrow-left" size=16}} Go back</a>
      <a class="btn btn-outline" href="/auth/accounts">Switch account</a>
    </div>
  </div>
</main>

{{#> portal/section}}
  <div class="page-header">
    <div>
      <h1 class="page-title">Credentials</h1>
      <p class="page-subtitle">API keys your systems use to issue and manage cards. Each key has its own scopes and IP whitelist.</p>
    </div>
    {{#if canManage}}
      <div class="page-actions">
        <button type="button" class="btn btn-primary" data-drawer-url="/merchant/integrations/credentials/new">{{icon "plus" size=16}} New credential</button>
      </div>
    {{/if}}
  </div>

  <div class="stack">
    <section class="table-card">
      <div id="credentials-table" class="data-table" data-table-url="/merchant/integrations/credentials/table" data-history="off">
        {{> integrations/credentials_table}}
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <div>
          <h2 class="card-title">Getting started</h2>
          <p class="card-subtitle">Exchange a credential for an access token, then call the card endpoints with it. Tokens last {{tokenMinutes}} minutes.</p>
        </div>
        <a class="btn btn-outline btn-sm" href="{{docsUrl}}" target="_blank" rel="noopener">{{icon "book-open" size=14}} API reference</a>
      </div>
      <div class="card-body">
        <pre class="code-block">curl -X POST {{apiBase}}/auth/token \
  -H "Content-Type: application/json" \
  -d '{"client_id": "&lt;client id&gt;", "client_secret": "&lt;client secret&gt;"}'

curl {{apiBase}}/cards -H "Authorization: Bearer &lt;access_token&gt;"</pre>
        <p class="field-hint mt-3">Calls must come from an IP address on the credential's whitelist. In production a credential without a whitelist can't be used.</p>
      </div>
    </section>
  </div>
{{/portal/section}}

    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/hbs": "^4.0.5",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",

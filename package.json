    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "connect-redis": "^9.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "form-data": "^4.0.6",
    "handlebars": "^4.7.10",
    "hbs": "^4.3.1",
    "lucide-static": "^1.55.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",

{{#> layout title="Reset your password"}}
  <h1>Reset your password</h1>
  <p>Hi {{name}},</p>
  <p>Use this code to choose a new password.</p>
  {{> code code=code}}
  <p>This code expires in {{expiryMinutes}} minutes.</p>
  <p class="muted">If you didn't ask to reset your password, you can safely ignore this email. Your password stays the same.</p>
{{/layout}}

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <style>
      body { margin: 0; padding: 0; background-color: #ecf0f2; font-family: Poppins, Arial, Helvetica, sans-serif; color: #303030; }
      .wrapper { width: 100%; padding: 24px 0; background-color: #ecf0f2; }
      .container { max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e2e7eb; }
      .header { padding: 22px 28px; background-color: #0a6cb0; color: #ffffff; font-size: 22px; font-weight: bold; letter-spacing: -0.01em; }
      .content { padding: 32px 28px; font-size: 15px; line-height: 1.6; }
      .content h1 { margin: 0 0 16px; font-size: 20px; color: #051145; }
      .content p { margin: 0 0 16px; }
      .muted { color: #64707d; font-size: 13px; }
      .footer { padding: 16px 24px; font-size: 12px; color: #8a949e; text-align: center; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">{{@appName}}</div>
        <div class="content">
          {{> @partial-block}}
        </div>
      </div>
      <div class="footer">
        This is an automated message from {{@appName}}. Please do not reply to this email.
      </div>
    </div>
  </body>
</html>
